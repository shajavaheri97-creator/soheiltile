# Copy to .env.local (dev) or to the server's environment (production)
# Generate: node scripts/hash-password.mjs "your-long-password"
ADMIN_PASSWORD_HASH=
# Generate: openssl rand -hex 32
SESSION_SECRET=
# Where the SQLite file and uploaded images live (back this folder up!)
DATA_DIR=./data
# Set to "false" only when testing a production build over plain http
# COOKIE_SECURE=false

# Public site URL (used for canonical links, sitemap, OG)
SITE_URL=http://localhost:3000

# dev only: LAN IP(s) you open the dev server from (comma separated), otherwise hydration/HMR is blocked
# DEV_ORIGINS=192.168.1.20
